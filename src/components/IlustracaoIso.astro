---
// Ilustrações isométricas: arquivos .svg estáticos em src/assets/iso, servidos
// como <img>. O navegador decodifica uma vez e cacheia — nada de gradientes
// recalculados no DOM nem ids duplicados, o que pesava no celular quando
// eram SVG inline. Para mudar o desenho, edite o arquivo .svg.
import torres from '../assets/iso/torres.svg';
import cubos from '../assets/iso/cubos.svg';
import cilindros from '../assets/iso/cilindros.svg';
import grade from '../assets/iso/grade.svg';
import discos from '../assets/iso/discos.svg';

interface Props {
  tipo: 'cubos' | 'cilindros' | 'grade' | 'discos' | 'torres';
  class?: string;
}

const { tipo, class: className } = Astro.props;

const imagens = { torres, cubos, cilindros, grade, discos };
const imagem = imagens[tipo];
---

<img
  src={imagem.src}
  width={imagem.width}
  height={imagem.height}
  alt=""
  loading="lazy"
  decoding="async"
  draggable="false"
  class={className}
/>
