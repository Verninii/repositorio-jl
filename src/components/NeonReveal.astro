---
import { NEON_DEFAULTS, type NeonConfig } from '../scripts/neon-reveal';

interface Props {
  config?: Partial<NeonConfig>;
  minHeight?: string;
  edgeFade?: boolean | string;
  class?: string;
}

const { config = {}, minHeight, edgeFade, class: className } = Astro.props;
const merged: NeonConfig = { ...NEON_DEFAULTS, ...config };
const fade = edgeFade === true ? '8%' : typeof edgeFade === 'string' ? edgeFade : undefined;

const hasForeground = Astro.slots.has('foreground');

const vars = `--nr-bg:${merged.backgroundColor};--nr-inset:${merged.inset}px;${
  minHeight ? `--nr-min-h:${minHeight};` : ''
}${fade ? `--nr-edge:${fade};` : ''}`;
---

<neon-reveal
  class:list={['neon-reveal', hasForeground && 'has-foreground', fade && 'has-edge-fade', className]}
  data-config={JSON.stringify(merged)}
  data-intro={merged.intro ? '' : undefined}
  style={vars}
>
  <div class="nr-content">
    <slot />
  </div>
  <canvas aria-hidden="true"></canvas>
  {
    hasForeground && (
      <div class="nr-foreground">
        <slot name="foreground" />
      </div>
    )
  }
</neon-reveal>

<noscript>
  <style>
    neon-reveal .nr-content {
      visibility: visible !important;
    }
  </style>
</noscript>

<style>
  neon-reveal {
    display: grid;
    width: 100%;
    min-height: var(--nr-min-h, 20rem);
    position: relative;
    overflow: hidden;
    background: var(--nr-bg, transparent);
  }
  .nr-content {
    grid-area: 1 / 1;
    z-index: 0;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 100%;
    padding: calc(var(--nr-inset, 24px) + 1.5rem) 1.5rem;
    position: relative;
  }
  neon-reveal > canvas {
    grid-area: 1 / 1;
    z-index: 1;
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .has-edge-fade > canvas {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--nr-edge, 8%),
      #000 calc(100% - var(--nr-edge, 8%)),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--nr-edge, 8%),
      #000 calc(100% - var(--nr-edge, 8%)),
      transparent
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  neon-reveal.has-foreground {
    display: block;
  }
  .has-foreground .nr-content {
    grid-area: auto;
    min-height: 0;
    padding-bottom: 0;
    margin-bottom: 3rem;
  }
  .nr-foreground {
    position: relative;
    z-index: 2;
  }

  neon-reveal[data-intro]:not(:defined) .nr-content {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    neon-reveal:not(:defined) .nr-content {
      visibility: visible;
    }
  }
</style>

<script>
  import { defineNeonReveal } from '../scripts/neon-reveal';
  defineNeonReveal();
</script>
