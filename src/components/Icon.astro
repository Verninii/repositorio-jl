---
// Ícones inline (stroke 1.8, viewBox 24) — evita dependência de biblioteca.
interface Props {
  name: 'cart' | 'bolt' | 'plug' | 'search' | 'chart' | 'arrow' | 'mail' | 'check';
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;

const paths: Record<Props['name'], string[]> = {
  cart: ['M2.5 3h2l2.2 11.2a2 2 0 0 0 2 1.6h8.1a2 2 0 0 0 2-1.6L20.5 7H6', 'M9 20.5h.01', 'M17 20.5h.01'],
  bolt: ['M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z'],
  plug: ['M9 2v6', 'M15 2v6', 'M6 8h12v3a6 6 0 0 1-6 6 6 6 0 0 1-6-6V8Z', 'M12 17v5'],
  search: ['M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z', 'm21 21-4.3-4.3'],
  chart: ['M3 21h18', 'M7 21V10', 'M12 21V4', 'M17 21v-7'],
  arrow: ['M5 12h14', 'm12 5 7 7-7 7'],
  mail: ['M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z', 'm3.5 6.5 8.5 6 8.5-6'],
  check: ['m4 12.5 5 5 11-11'],
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
