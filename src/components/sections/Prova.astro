---
import { PROCESSO, DEPOIMENTOS } from '../../consts';

// Etapas numeradas 01..04 — o número sai do índice para não duplicar dado em consts.
const etapas = PROCESSO.map((etapa, i) => ({
  ...etapa,
  numero: String(i + 1).padStart(2, '0'),
}));
---

<!-- PROVA — faixa creme full width com duas partes empilhadas: processo e depoimentos. -->
<section id="processo" class="bg-butter-200 w-full py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6 sm:px-10">
    <!-- PARTE 1 — PROCESSO -->
    <div class="border-ink-900/15 border-b pb-5">
      <p class="text-ink-500 text-[0.7rem] font-semibold tracking-[0.32em] uppercase sm:text-xs">
        Como trabalhamos
      </p>
    </div>

    <h2 class="display text-peri-500 mt-8 text-5xl sm:text-7xl lg:text-8xl">Nosso processo</h2>

    <p class="text-ink-700 mt-6 max-w-2xl text-base leading-relaxed text-pretty sm:text-lg">
      Quatro etapas, sempre nesta ordem. Nosso time abre o cronograma no começo e mantém você
      acompanhando cada entrega até a publicação.
    </p>

    <ol class="mt-12 grid gap-5 sm:mt-14 sm:grid-cols-2 lg:grid-cols-4">
      {
        etapas.map((etapa) => (
          <li class="border-ink-900/10 flex flex-col rounded-2xl border bg-white p-6 sm:p-7">
            <span
              class="display bg-peri-500 flex size-12 shrink-0 items-center justify-center rounded-full text-base text-white"
              aria-hidden="true"
            >
              {etapa.numero}
            </span>
            <h3 class="text-ink-900 mt-5 text-lg font-semibold sm:text-xl">
              <span class="sr-only">Etapa {etapa.numero}: </span>
              {etapa.titulo}
            </h3>
            <p class="text-ink-700 mt-2.5 text-sm leading-relaxed text-pretty sm:text-base">
              {etapa.texto}
            </p>
          </li>
        ))
      }
    </ol>

    <!-- PARTE 2 — DEPOIMENTOS -->
    <div class="border-ink-900/15 mt-24 border-t pt-16 sm:mt-32 sm:pt-20">
      <h2 class="display text-peri-500 text-5xl sm:text-7xl lg:text-8xl">O que dizem</h2>

      <div class="mt-12 grid gap-5 sm:mt-14 lg:grid-cols-2">
        {
          DEPOIMENTOS.map((depoimento) => (
            <figure class="border-ink-900/10 flex flex-col rounded-2xl border bg-white p-7 sm:p-9">
              <span class="display text-peri-400 text-6xl leading-none sm:text-7xl" aria-hidden="true">
                &ldquo;
              </span>
              <blockquote class="text-ink-900 mt-3 text-lg leading-snug font-medium text-pretty sm:text-xl">
                {depoimento.texto}
              </blockquote>
              <figcaption class="border-ink-900/10 mt-7 border-t pt-5 text-sm sm:text-base">
                <span class="text-ink-900 block font-semibold">{depoimento.autor}</span>
                <span class="text-ink-500 mt-0.5 block">{depoimento.cargo}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
