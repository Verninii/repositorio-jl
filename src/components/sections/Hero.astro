---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import heroImagem from '../../assets/hero.webp';
import { SITE } from '../../consts';
---

<section
  id="inicio"
  class="bg-peri-900 relative isolate flex h-screen min-h-fit w-full flex-col overflow-hidden text-white"
>
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <Picture
      src={heroImagem}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 2752]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      pictureAttributes={{ class: 'absolute inset-0' }}
      class="size-full object-cover object-center"
    />
    <div class="bg-peri-900/55 absolute inset-0 sm:bg-peri-900/35"></div>
    <div class="from-peri-900/90 via-peri-900/55 absolute inset-0 bg-linear-to-r to-transparent"></div>
    <div
      class="from-peri-900 via-peri-900/40 absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t to-transparent"
    >
    </div>
  </div>

  <div
    class="mx-auto flex w-full max-w-7xl flex-1 flex-col px-6 pt-28 pb-10 sm:px-10 sm:pt-36 sm:pb-16"
  >
    <div class="max-w-5xl">
      <p class="text-peri-300 text-[0.8125rem] font-medium sm:text-sm">{SITE.tagline}</p>

      <h1 class="titulo font-display text-butter-50 mt-5 text-balance sm:mt-6">
        Tire a sua loja<br />
        do papel.
      </h1>
    </div>

    <div class="mt-auto max-w-xl pt-10">
      <p class="text-base leading-relaxed text-pretty text-white/75 sm:text-lg">
        Somos a {SITE.company}, um time de desenvolvedores que constrói e-commerce de ponta a ponta
        — da estrutura do tema Shopify à última métrica de performance.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-2 sm:mt-10 sm:gap-3">
        <a
          href="#projetos"
          class="bg-butter-200 text-ink-900 hover:bg-butter-50 focus-visible:outline-butter-200 inline-flex min-h-12 items-center gap-2 rounded-full px-4 py-3.5 text-[0.8125rem] font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 sm:px-6 sm:text-sm"
        >
          Ver projetos
          <Icon name="arrow" class="size-4" />
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="focus-visible:outline-butter-200 inline-flex min-h-12 items-center gap-2 rounded-full border border-white/30 px-4 py-3.5 text-[0.8125rem] font-semibold transition-colors hover:border-white/50 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 sm:px-6 sm:text-sm"
          aria-label={`Falar com a gente por e-mail: ${SITE.email}`}
        >
          <Icon name="mail" class="size-4" />
          Falar com a gente
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .titulo {
    font-size: clamp(2.125rem, min(9.5vw, 11vh), 6.5rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
</style>
