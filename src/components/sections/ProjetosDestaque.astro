---
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import siteDeJandira from '../../assets/site-de-jandira.png';
import ProjectCard from '../ProjectCard.astro';
import Icon from '../Icon.astro';
import NeonReveal from '../NeonReveal.astro';

interface Props {
  projetos: CollectionEntry<'projetos'>[];
}

const { projetos } = Astro.props;

const slides = await Promise.all(
  projetos.map(async (projeto) => {
    const fonte = projeto.data.capa ?? siteDeJandira;
    const imagem = await getImage({ src: fonte, width: 1200, format: 'webp' });
    return {
      src: imagem.src,
      alt: projeto.data.capa ? (projeto.data.capaAlt ?? projeto.data.title) : projeto.data.title,
      title: projeto.data.title,
      subtitle: `${projeto.data.tipo} · ${projeto.data.ano}`,
      href: `/projetos/${projeto.id}`,
    };
  }),
);

const BOTAO =
  'group text-white border-white/35 hover:border-white hover:bg-white hover:text-noite-900 focus-visible:outline-white grid size-11 place-items-center rounded-full border transition-colors focus-visible:outline-2 focus-visible:outline-offset-2';
---

<section
  id="projetos"
  class="folha bg-noite-600 w-full scroll-mt-24 overflow-hidden pt-16 pb-(--folha) sm:pt-20"
>
  <NeonReveal
    class="mx-auto max-w-6xl"
    edgeFade="30%"
    config={{
      backgroundColor: '#2f6fd6',
      colors: ['#d7e6ff', '#8fb8f5'],
      forceMode: 'dark',
      trigger: 'inView',
      revealDelay: 150,
      reach: 2.5,
      intensity: 1.1,
      glow: 1.1,
      length: 1,
    }}
  >
    <div class="text-center">
      <p class="rotulo text-white/85">03 — Projetos em destaque</p>
      <h2 class="display mt-3 text-5xl text-white sm:text-7xl">Resultados reais</h2>
    </div>

    <div slot="foreground" class="px-6 pb-14 sm:px-12 sm:pb-20">
      {
        slides.length > 0 ? (
          <>
            <div class="relative z-10 flex justify-end">
              <a
                href="/projetos"
                class="inline-flex origin-right rotate-357 items-center gap-2 px-2 py-2.5 text-sm font-semibold text-white transition-colors hover:text-white/70"
              >
                Ver todos
              </a>
            </div>

            <div
              class="relative -mt-22 text-white"
              data-concave-root
              data-slides={JSON.stringify(slides)}
              role="region"
              aria-roledescription="carrossel"
              aria-label="Projetos em destaque"
              tabindex="0"
              hidden
            >
              <div
                class="relative h-[340px] touch-pan-y select-none sm:h-[500px]"
                data-stage
              >
                <canvas class="absolute inset-0 block h-full w-full" data-canvas aria-hidden="true" />
              </div>

              <div class="mt-4 text-center">
                <div class="flex h-12 flex-col items-center justify-center" data-caption>
                  <p class="display max-w-full truncate text-xl text-white sm:text-2xl" data-title />
                  <p class="mt-1 max-w-full truncate text-sm text-white/85" data-subtitle />
                </div>

                <div class="mt-10 flex items-center justify-center gap-4 sm:mt-12">
                  <button type="button" class={BOTAO} aria-label="Projeto anterior" data-prev>
                    <Icon
                      name="arrow"
                      class="size-4 rotate-180 transition-transform group-hover:-translate-x-0.5"
                    />
                  </button>

                  <div class="flex items-center">
                    {
                      slides.map((_, i) => (
                        <button
                          type="button"
                          class="group grid h-6 place-items-center rounded-full px-1 focus-visible:outline-2 focus-visible:outline-white"
                          aria-label={`Ir para o projeto ${i + 1}`}
                          aria-current={i === 0 ? 'true' : 'false'}
                          data-ponto
                        >
                          <span class="h-2 w-2 rounded-full bg-white/40 transition-all duration-300 group-hover:bg-white/70 group-aria-[current=true]:w-6 group-aria-[current=true]:bg-white" />
                        </button>
                      ))
                    }
                  </div>

                  <button type="button" class={BOTAO} aria-label="Próximo projeto" data-next>
                    <Icon
                      name="arrow"
                      class="size-4 transition-transform group-hover:translate-x-0.5"
                    />
                  </button>
                </div>
              </div>

              <p class="sr-only" aria-live="polite" data-live />
            </div>

            <div class="mt-10 grid gap-5 sm:grid-cols-2" data-fallback>
              {projetos.map((projeto) => (
                <ProjectCard projeto={projeto} />
              ))}
            </div>
          </>
        ) : (
          <p class="mt-10 text-white/85">
            Nenhum projeto publicado. Adicione um arquivo em <code>src/content/projetos/</code>.
          </p>
        )
      }
    </div>
  </NeonReveal>
</section>

<style>
  [data-concave-root][hidden],
  [data-fallback][hidden] {
    display: none;
  }
</style>

<script>
  import { createConcaveEngine, readPalette, type ConcaveConfig } from '../../scripts/concave-carousel';

  interface Slide {
    src: string;
    alt: string;
    title: string;
    subtitle: string;
    href: string;
  }

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-concave-root]')) {
    const stage = root.querySelector<HTMLElement>('[data-stage]');
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]');
    const titleEl = root.querySelector<HTMLElement>('[data-title]');
    const subtitleEl = root.querySelector<HTMLElement>('[data-subtitle]');
    const pontos = [...root.querySelectorAll<HTMLButtonElement>('[data-ponto]')];
    const liveEl = root.querySelector<HTMLElement>('[data-live]');
    const captionEl = root.querySelector<HTMLElement>('[data-caption]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
    const fallback = root.parentElement?.querySelector<HTMLElement>('[data-fallback]');

    if (!stage || !canvas) continue;

    let slides: Slide[] = [];
    try {
      slides = JSON.parse(root.dataset.slides || '[]');
    } catch {
      continue;
    }
    if (slides.length === 0) continue;

    const config: ConcaveConfig = {
      count: slides.length,
      aspect: 1.25,
      size: 0.46,
      curvature: 0.72,
      distance: 4,
      tilt: 0,
      gap: 16,
      radius: 14,
      reflection: 0.06,
      dim: 0.40,
      autoplay: 'drift',
      speed: 0.16,
      interval: 4,
      snap: true,
      inertia: 0.5,
      pauseOnHover: true,
      draggable: true,
      wheel: false,
      paused: false,
      reducedMotion: reduceMotion.matches,
      dpr: 2,
      palette: null,
    };

    const renderCaption = (i: number) => {
      const slide = slides[i];
      if (!slide) return;
      if (titleEl) titleEl.textContent = slide.title;
      if (subtitleEl) subtitleEl.textContent = slide.subtitle;
      pontos.forEach((ponto, j) => ponto.setAttribute('aria-current', String(j === i)));
      if (liveEl) liveEl.textContent = `Projeto ${i + 1} de ${slides.length}: ${slide.title}`;
      if (captionEl && !reduceMotion.matches) {
        captionEl.animate(
          [
            { opacity: 0, transform: 'translateY(6px)', filter: 'blur(4px)' },
            { opacity: 1, transform: 'none', filter: 'blur(0)' },
          ],
          { duration: 420, easing: 'cubic-bezier(.2,.7,.2,1)' },
        );
      }
    };

    const engine = createConcaveEngine(canvas, stage, {
      startIndex: 0,
      getConfig: () => config,
      onActive: (i) => renderCaption(i),
      onSelect: (i) => {
        const href = slides[i]?.href;
        if (href) window.location.assign(href);
      },
    });

    if (!engine) continue;

    root.hidden = false;
    if (fallback) fallback.hidden = true;

    config.palette = readPalette(stage, 'transparent');
    engine.setItems(slides.map((s) => s.src));
    renderCaption(0);

    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      config.palette = readPalette(stage, 'transparent');
      engine.invalidate();
    });
    reduceMotion.addEventListener('change', () => {
      config.reducedMotion = reduceMotion.matches;
    });

    stage.addEventListener('pointerdown', (e) => engine.pointerDown(e));
    stage.addEventListener('pointermove', (e) => engine.pointerMove(e));
    stage.addEventListener('pointerup', (e) => engine.pointerUp(e));
    stage.addEventListener('pointercancel', (e) => engine.pointerUp(e, true));
    stage.addEventListener('pointerleave', () => engine.pointerLeave());

    pontos.forEach((ponto, j) => ponto.addEventListener('click', () => engine.goTo(j)));
    prevBtn?.addEventListener('click', () => engine.previous());
    nextBtn?.addEventListener('click', () => engine.next());

    root.addEventListener('keydown', (e) => {
      if (e.target !== e.currentTarget) return;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        engine.next();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        engine.previous();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        engine.selectCurrent();
      } else if (e.key === ' ') {
        e.preventDefault();
        config.paused = !config.paused;
      }
    });
  }
</script>
