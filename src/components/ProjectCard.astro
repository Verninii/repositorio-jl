---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import placeholder from '../assets/placeholder-projeto.webp';
import scentine from '../assets/scentine.jpg';

interface Props {
  projeto: CollectionEntry<'projetos'>;
}

const { projeto } = Astro.props;
const { data } = projeto;
const href = `/projetos/${projeto.id}`;
---

<article
  class="group bg-noite-900 relative flex flex-col overflow-hidden rounded-3xl border border-white/15 text-white shadow-[inset_0_1px_0_0_rgb(255_255_255/0.12)] transition duration-300 hover:-translate-y-1 hover:border-white/35"
>
  <a href={href} class="flex h-full flex-col focus:outline-none">
    <div class="relative m-3 aspect-[16/10] overflow-hidden rounded-2xl">
      <Image
        src={data.capa ?? scentine}
        alt={data.capa ? (data.capaAlt ?? data.title) : ''}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        widths={[480, 800, 1200]}
        sizes="(min-width: 640px) 50vw, 100vw"
        aria-hidden={data.capa ? undefined : 'true'}
      />

      {
        !data.capa && (
          <span class="absolute inset-0 grid place-items-center bg-black/35 px-8 text-center">
            <span class="display text-2xl text-white sm:text-3xl">
              {data.cliente ?? data.title}
            </span>
          </span>
        )
      }
    </div>

    <div class="flex flex-1 flex-col px-6 pt-3 pb-6">
      <p class="text-noite-300 flex items-center gap-2 text-[11px] font-semibold tracking-widest uppercase">
        {data.tipo}
        <span aria-hidden="true">·</span>
        <span>{data.ano}</span>
      </p>

      <h3 class="display mt-2.5 text-2xl text-white">
        <span class="after:absolute after:inset-0 after:content-['']">{data.title}</span>
      </h3>

      <p class="text-noite-200/85 mt-2 text-sm leading-relaxed">{data.description}</p>

      {
        data.metricas.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {data.metricas.map((m) => (
              <li class="text-noite-900 rounded-lg bg-white px-2.5 py-1.5 text-xs font-semibold">
                {m.valor} <span class="font-normal opacity-80">{m.label}</span>
              </li>
            ))}
          </ul>
        )
      }

      <ul class="mt-auto flex flex-wrap gap-1.5 pt-5">
        {
          data.stack.map((tec) => (
            <li class="text-noite-200 rounded-full border border-white/20 px-2.5 py-1 text-xs">
              {tec}
            </li>
          ))
        }
      </ul>
    </div>
  </a>
</article>
