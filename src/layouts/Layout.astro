---
import '../styles/global.css';
import { Font } from 'astro:assets';
import SEO from '../components/SEO.astro';
import Icon from '../components/Icon.astro';
import { SITE, SERVICOS } from '../consts';

type SEOProps = Parameters<typeof SEO>[0];

type Props = SEOProps & {
  headerSobreposto?: boolean;
};

const { headerSobreposto = false, ...props } = Astro.props as Props;
const path = Astro.url.pathname;

const nav = [
  { href: '/projetos', label: 'Projetos' },
  { href: '/#processo', label: 'Processo' },
  { href: '/#depoimentos', label: 'Depoimentos' },
];

const isActive = (href: string) => href.startsWith('/') && !href.includes('#') && path.startsWith(href);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <SEO {...props} />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-playfair" />
  </head>
  <body class="bg-butter-200 text-ink-900 font-sans min-h-dvh antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:bg-ink-900 focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Pular para o conteúdo
    </a>

    <header class="pointer-events-none fixed inset-x-0 top-0 z-40 px-3 pt-3 sm:px-6 sm:pt-5">
      <div
        class="bg-butter-50/85 supports-[backdrop-filter]:bg-butter-50/65 shadow-ink-900/10 pointer-events-auto mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 rounded-full border border-white/60 pr-2 pl-5 shadow-lg backdrop-blur-xl backdrop-saturate-150 sm:h-16 sm:pl-7"
      >
        <a href="/" class="group flex shrink-0 items-center gap-2.5">
          <!-- Logomark: anel + ponto, referência ao nome "Órbita". -->
          <svg
            viewBox="0 0 24 24"
            class="text-peri-600 size-6 shrink-0 transition-transform group-hover:rotate-45"
            aria-hidden="true"
          >
            <circle
              cx="12"
              cy="12"
              r="8.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              opacity="0.6"></circle>
            <circle cx="19.5" cy="8.5" r="2.2" fill="currentColor"></circle>
          </svg>
          <span class="display text-peri-600 text-lg sm:text-xl">{SITE.company}</span>
        </a>

        <nav
          aria-label="Principal"
          class="hidden items-center gap-8 text-xs font-semibold tracking-widest uppercase md:flex"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'transition-colors',
                  isActive(item.href) ? 'text-peri-600' : 'text-ink-700 hover:text-peri-600',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <a
          href={`mailto:${SITE.email}`}
          class="bg-peri-500 hover:bg-peri-600 inline-flex h-10 shrink-0 items-center rounded-full px-4 text-xs font-semibold tracking-widest whitespace-nowrap text-white uppercase transition-colors sm:h-12 sm:px-6"
        >
          Contato
        </a>
      </div>
    </header>

    <main id="conteudo" class:list={[!headerSobreposto && 'pt-20 sm:pt-24']}>
      <slot />
    </main>

    <!-- Rodapé em colunas: marca + chamada à esquerda, mapa do site à direita. -->
    <footer class="bg-ceu-900 w-full">
      <div class="text-ceu-300 mx-auto max-w-7xl px-6 pt-16 pb-8 sm:px-10 sm:pt-20">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-5">
            <p class="display-serif text-sol-200 text-5xl leading-none sm:text-6xl">{SITE.company}</p>
            <p class="mt-5 max-w-sm text-sm leading-relaxed">
              {SITE.tagline}. Lojas Shopify rápidas, integrações e SEO técnico para marcas
              brasileiras.
            </p>
            <a
              href={`mailto:${SITE.email}`}
              class="bg-sol-300 text-ink-900 hover:bg-sol-200 mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition-colors"
            >
              Fale conosco
              <Icon name="arrow" class="size-4" />
            </a>
          </div>

          <nav aria-label="Rodapé" class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:col-span-7">
            <div>
              <p class="rotulo text-sol-200">Navegação</p>
              <ul class="mt-5 space-y-3 text-sm">
                {
                  [{ href: '/', label: 'Início' }, ...nav].map((item) => (
                    <li>
                      <a href={item.href} class="transition-colors hover:text-white">
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div>
              <p class="rotulo text-sol-200">Serviços</p>
              <ul class="mt-5 space-y-3 text-sm">
                {
                  SERVICOS.map((servico) => (
                    <li>
                      <a href="/#servicos" class="transition-colors hover:text-white">
                        {servico.titulo}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="col-span-2 sm:col-span-1">
              <p class="rotulo text-sol-200">Contato</p>
              <ul class="mt-5 space-y-3 text-sm">
                <li>
                  <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-white">
                    {SITE.email}
                  </a>
                </li>
                <li>
                  <a href={SITE.telefone.link} class="transition-colors hover:text-white">
                    {SITE.telefone.exibicao}
                  </a>
                </li>
                {
                  SITE.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        rel="noopener noreferrer me"
                        target="_blank"
                        class="transition-colors hover:text-white"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </nav>
        </div>

        <div
          class="border-ceu-700 mt-16 flex flex-wrap items-center justify-between gap-4 border-t pt-6 text-xs"
        >
          <p>&copy; {new Date().getFullYear()} {SITE.company}. Todos os direitos reservados.</p>
          <a href="#" class="transition-colors hover:text-white">Voltar ao topo ↑</a>
        </div>
      </div>
    </footer>
  </body>
</html>
