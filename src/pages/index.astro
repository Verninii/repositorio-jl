---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import IlustracaoIso from '../components/IlustracaoIso.astro';
import Hero from '../components/sections/Hero.astro';
import Depoimentos from '../components/sections/Depoimentos.astro';
import ProjetosDestaque from '../components/sections/ProjetosDestaque.astro';
import { SITE, SERVICOS, PROCESSO, STACK } from '../consts';

const projetos = (await getCollection('projetos', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.ordem - b.data.ordem || b.data.ano - a.data.ano,
);

const destaques = projetos.slice(0, 4);
---

<Layout description={SITE.description} headerSobreposto>
  <Hero />

  <section
    id="servicos"
    class="relative isolate w-full scroll-mt-24 overflow-hidden bg-[linear-gradient(160deg,#16399a,var(--color-noite-700)_60%,#2a62c8)] py-20 text-white sm:py-28 lg:py-32"
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-40 -left-32 size-[30rem] bg-[radial-gradient(closest-side,rgb(143_184_245/0.32),transparent)]"></div>
      <div class="absolute -right-32 -bottom-48 size-[30rem] bg-[radial-gradient(closest-side,rgb(7_20_51/0.5),transparent)]"></div>
    </div>

    <div class="mx-auto grid max-w-6xl gap-12 px-6 sm:px-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="text-noite-100/85 text-sm font-medium">No que trabalhamos</p>
        <h2 class="mt-5 text-5xl leading-[1.02] font-bold tracking-[-0.04em] text-balance sm:text-6xl">
          Frentes que destravam um e-commerce
        </h2>
        <p class="mt-6 max-w-sm leading-relaxed text-white/85">
          Cada projeto entra com um time pequeno e dedicado. Sem repasse para terceiros, sem
          código que você não pode ler depois.
        </p>
        <a
          href="/projetos"
          class="text-noite-900 hover:bg-noite-100 focus-visible:outline-noite-100 mt-8 inline-flex min-h-12 items-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          Ver projetos
          <Icon name="arrow" class="size-4" />
        </a>
      </div>

      <div
        class="bg-noite-950/35 rounded-3xl border border-white/20 px-5 shadow-[inset_0_1px_0_0_rgb(255_255_255/0.25)] sm:px-8 md:backdrop-blur-xl"
        data-acordeao
      >
        {
          SERVICOS.map((servico, i) => (
            <div
              class="group border-b border-white/15 last:border-b-0"
              data-item
              data-aberto={String(i === 0)}
            >
              <h3>
                <button
                  type="button"
                  id={`servico-${i}`}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`servico-painel-${i}`}
                  class="flex w-full cursor-pointer touch-manipulation items-center gap-4 py-6 text-left [-webkit-tap-highlight-color:transparent] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-white"
                >
                  <span
                    class="w-7 shrink-0 text-sm tabular-nums text-white/60 transition-colors group-data-[aberto=true]:text-white"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="flex-1 text-xl font-semibold tracking-[-0.02em] sm:text-2xl">
                    {servico.titulo}
                  </span>
                  <span
                    class="grid size-10 shrink-0 place-items-center rounded-full border border-white/30 transition-colors group-data-[aberto=true]:border-white group-data-[aberto=true]:bg-white group-data-[aberto=true]:text-noite-900"
                    aria-hidden="true"
                  >
                    <Icon
                      name="arrow"
                      class="size-4 transition-transform duration-300 group-data-[aberto=true]:-rotate-90"
                    />
                  </span>
                </button>
              </h3>
              <div
                id={`servico-painel-${i}`}
                role="region"
                aria-labelledby={`servico-${i}`}
                inert={i !== 0}
                class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 group-data-[aberto=true]:grid-rows-[1fr]"
              >
                <div class="overflow-hidden">
                  <div class="flex items-start gap-4 pr-14 pb-7 pl-11 sm:pr-16">
                    <span
                      class="text-noite-900 mt-0.5 grid size-10 shrink-0 place-items-center rounded-xl bg-white"
                      aria-hidden="true"
                    >
                      <Icon name={servico.icone} class="size-5" />
                    </span>
                    <p class="leading-relaxed text-white/85">{servico.texto}</p>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="processo"
    class="relative isolate w-full scroll-mt-24 overflow-hidden bg-[linear-gradient(165deg,var(--color-noite-950),var(--color-noite-900)_55%,#16399a)] py-20 text-white sm:py-28 lg:py-32"
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 -right-24 size-[40rem] bg-[radial-gradient(closest-side,rgb(59_123_224/0.5),transparent)]"></div>
      <div class="absolute -bottom-48 -left-32 size-[34rem] bg-[radial-gradient(closest-side,rgb(29_74_176/0.6),transparent)]"></div>
    </div>

    <div class="mx-auto max-w-6xl px-6 sm:px-10">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-6">
        <div>
          <p class="text-noite-300 text-sm font-medium">Como trabalhamos</p>
          <h2 class="mt-5 text-6xl leading-[0.98] font-bold tracking-[-0.04em] sm:text-8xl">
            Entenda.<br />Planeje.<br />Entregue.
          </h2>
          <p class="mt-7 max-w-md text-base leading-relaxed text-white/80 sm:text-lg">
            Quatro etapas, sempre nessa ordem — você sabe em que ponto o projeto está do primeiro
            ao último dia.
          </p>
          <a
            href={`mailto:${SITE.email}`}
            class="text-noite-900 hover:bg-noite-100 focus-visible:outline-noite-300 mt-9 inline-flex min-h-12 items-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            Falar com a gente
            <Icon name="arrow" class="size-4" />
          </a>
        </div>

        <IlustracaoIso tipo="torres" class="mx-auto h-auto w-full max-w-md lg:max-w-none" />
      </div>

      <ol class="mt-16 grid gap-4 sm:mt-20 sm:grid-cols-2 lg:grid-cols-4">
        {
          PROCESSO.map((etapa, i) => (
            <li class="group relative flex flex-col rounded-3xl border border-white/25 bg-white/10 p-5 shadow-[inset_0_1px_0_0_rgb(255_255_255/0.35),0_24px_48px_-24px_rgb(2_8_30/0.7)] md:backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:bg-white/15">
              <div class="flex items-center justify-between">
                <p class="text-xs font-medium tracking-wide text-white/80">
                  Etapa {String(i + 1).padStart(2, '0')}
                </p>
                <span
                  class="text-noite-900 grid size-9 place-items-center rounded-full bg-white"
                  aria-hidden="true"
                >
                  <Icon name="arrow" class="size-4 -rotate-45 transition-transform duration-300 group-hover:rotate-0" />
                </span>
              </div>
              <IlustracaoIso
                tipo={['cubos', 'cilindros', 'grade', 'discos'][i] as 'cubos'}
                class="mx-auto mt-4 h-32 w-full max-w-52"
              />
              <h3 class="mt-4 text-2xl font-semibold tracking-[-0.02em]">{etapa.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/80">{etapa.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <ProjetosDestaque projetos={destaques} />

  <Depoimentos />

  <section id="stack" class="bg-noite-100 w-full scroll-mt-24 py-16 sm:py-20 lg:py-24">
    <div
      class="mx-auto grid max-w-6xl items-center gap-10 px-6 sm:px-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16"
    >
      <div>
        <p class="text-noite-700 text-sm font-medium">Stack</p>
        <h2 class="text-noite-900 mt-4 text-4xl leading-[1.05] font-bold tracking-[-0.04em] text-balance sm:text-5xl">
          Ferramentas que usamos no dia a dia
        </h2>
      </div>

      <ul class="flex flex-wrap gap-3">
        {
          STACK.map((tec) => (
            <li class="text-noite-900 border-noite-200 hover:bg-noite-900 inline-flex items-center gap-2.5 rounded-full border bg-white px-5 py-2.5 text-sm font-semibold shadow-[0_10px_24px_-14px_rgb(11_30_74/0.45)] transition-colors hover:text-white">
              <span class="bg-noite-500 size-1.5 rounded-full" aria-hidden="true" />
              {tec}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    class="relative isolate w-full overflow-hidden bg-[linear-gradient(165deg,var(--color-noite-950),var(--color-noite-900)_55%,#16399a)] py-20 text-white sm:py-28 lg:py-32"
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-40 -left-24 size-[30rem] bg-[radial-gradient(closest-side,rgb(59_123_224/0.45),transparent)]"></div>
      <div class="absolute -right-24 -bottom-48 size-[30rem] bg-[radial-gradient(closest-side,rgb(29_74_176/0.6),transparent)]"></div>
    </div>

    <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 sm:px-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="text-noite-300 text-sm font-medium">Próximo passo</p>
        <h2 class="mt-5 text-5xl leading-[1] font-bold tracking-[-0.04em] text-balance sm:text-7xl">
          Tem um projeto em mente?
        </h2>

        <div class="mt-12 max-w-md space-y-8">
          <div class="text-noite-900 relative rounded-3xl bg-white p-6 shadow-[0_24px_48px_-24px_rgb(2_8_30/0.8)] sm:p-7">
            <p class="text-sm font-semibold">Conte pra gente</p>
            <p class="text-noite-900/75 mt-2 text-sm leading-relaxed">
              Diga o que você precisa construir: um site, uma loja, um app ou uma integração.
            </p>
            <svg
              viewBox="0 0 24 16"
              class="absolute -bottom-3.5 left-10 h-4 w-6 text-white"
              aria-hidden="true"
            >
              <path d="M0 0h24L8 16z" fill="currentColor"></path>
            </svg>
          </div>

          <div class="bg-noite-700 relative ml-auto max-w-sm rounded-3xl border border-white/20 p-6 shadow-[0_24px_48px_-24px_rgb(2_8_30/0.8)] sm:p-7">
            <p class="text-sm font-semibold">A gente responde</p>
            <p class="mt-2 text-sm leading-relaxed text-white/85">
              Com um diagnóstico honesto do escopo — inclusive se não formos o time certo para o
              trabalho.
            </p>
            <svg
              viewBox="0 0 24 16"
              class="text-noite-700 absolute right-10 -bottom-3.5 h-4 w-6"
              aria-hidden="true"
            >
              <path d="M24 0H0l16 16z" fill="currentColor"></path>
            </svg>
          </div>
        </div>
      </div>

      <div class="text-noite-900 rounded-3xl bg-white p-6 shadow-[0_24px_48px_-24px_rgb(2_8_30/0.8)] sm:p-8">
        <p class="text-lg font-semibold tracking-[-0.01em]">Fale com a gente</p>
        <div class="mt-5 space-y-3">
          <a
            href={`mailto:${SITE.email}`}
            class="bg-noite-100 hover:bg-noite-200 focus-visible:outline-noite-700 group flex min-h-12 items-center justify-between gap-3 rounded-full px-5 py-3 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <span class="truncate">{SITE.email}</span>
            <Icon name="arrow" class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5" />
          </a>
          <a
            href={SITE.telefone.link}
            class="bg-noite-100 hover:bg-noite-200 focus-visible:outline-noite-700 group flex min-h-12 items-center justify-between gap-3 rounded-full px-5 py-3 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <span>{SITE.telefone.exibicao}</span>
            <Icon name="arrow" class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5" />
          </a>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <ul class="flex gap-2">
            {
              SITE.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer me"
                    class="bg-noite-900 hover:bg-noite-700 focus-visible:outline-noite-700 inline-flex h-11 items-center rounded-full px-4 text-xs font-semibold text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href={`mailto:${SITE.email}`}
            class="bg-noite-900 hover:bg-noite-700 focus-visible:outline-noite-700 inline-flex min-h-11 items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <Icon name="mail" class="size-4" />
            Enviar e-mail
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-acordeao]')) {
    const itens = [...raiz.querySelectorAll<HTMLElement>('[data-item]')];

    const definir = (item: HTMLElement, aberto: boolean) => {
      item.dataset.aberto = String(aberto);
      item.querySelector('button')?.setAttribute('aria-expanded', String(aberto));
      const painel = item.querySelector<HTMLElement>('[role="region"]');
      if (painel) painel.inert = !aberto;
    };

    raiz.addEventListener('click', (evento) => {
      const botao = (evento.target as Element).closest('button[aria-controls]');
      const item = botao?.closest<HTMLElement>('[data-item]');
      if (!item) return;
      const abrir = item.dataset.aberto !== 'true';
      for (const outro of itens) definir(outro, outro === item && abrir);
    });
  }
</script>

<style>
  .orbita-ponto {
    transform-box: view-box;
    transform-origin: 100px 100px;
    animation: orbitar 10s linear infinite;
  }

  @keyframes orbitar {
    to {
      transform: rotate(360deg);
    }
  }
</style>
