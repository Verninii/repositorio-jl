---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { SITE, NUMEROS, SERVICOS, PROCESSO, DEPOIMENTOS, STACK } from '../consts';

const projetos = (await getCollection('projetos', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.ordem - b.data.ordem || b.data.ano - a.data.ano,
);

const destaques = projetos.slice(0, 4);
---

<Layout description={SITE.description}>
  <div class="mx-auto max-w-6xl space-y-4 px-4 pt-4 pb-4">
    <!-- HERO -->
    <section
      class="bg-butter-200 relative overflow-hidden rounded-3xl px-6 py-14 sm:px-12 sm:py-20"
    >
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
        <div class="min-w-0">
          <p
            class="border-ink-900/20 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold tracking-widest uppercase"
          >
            <span class="relative flex size-2">
              <span
                class="bg-peri-600 absolute inline-flex h-full w-full animate-ping rounded-full opacity-60"
              ></span>
              <span class="bg-peri-600 relative inline-flex size-2 rounded-full"></span>
            </span>
            {SITE.tagline}
          </p>

          <h1 class="display mt-6 text-6xl sm:text-7xl lg:text-8xl">
            Lojas que<br /><span class="text-peri-600">carregam rápido</span><br />e vendem
          </h1>

          <p class="text-ink-700 mt-6 max-w-lg text-lg leading-relaxed">
            Somos a {SITE.company}, um time de desenvolvedores que constrói e-commerce de ponta
            a ponta — da estrutura do tema Shopify à última métrica de performance.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="#projetos"
              class="bg-ink-900 hover:bg-peri-600 inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-sm font-semibold text-white transition-colors"
            >
              Ver nossos projetos
              <Icon name="arrow" class="size-4" />
            </a>
            <a
              href={`mailto:${SITE.email}`}
              class="border-ink-900/25 hover:bg-ink-900/5 inline-flex items-center gap-2 rounded-full border px-6 py-3.5 text-sm font-semibold transition-colors"
            >
              <Icon name="mail" class="size-4" />
              Conversar sobre um projeto
            </a>
          </div>
        </div>

        <!-- Preview de marca no lugar de uma foto do time. Troque por um
             screenshot real ou foto quando tiver um pronto. -->
        <div class="relative mx-auto w-full max-w-sm min-w-0 lg:mx-0 lg:max-w-none">
          <div
            class="border-ink-900/15 overflow-hidden rounded-3xl border bg-white shadow-xl shadow-black/5"
          >
            <div class="border-ink-900/10 flex items-center gap-1.5 border-b px-4 py-3">
              <span class="size-2.5 rounded-full bg-rose-400"></span>
              <span class="size-2.5 rounded-full bg-amber-400"></span>
              <span class="size-2.5 rounded-full bg-emerald-400"></span>
              <span class="text-ink-500 bg-butter-100 mx-auto rounded-full px-3 py-1 text-xs">
                {new URL(SITE.url).host}
              </span>
            </div>
            <div class="bg-peri-500 relative grid aspect-[4/5] place-items-center overflow-hidden">
              <svg viewBox="0 0 200 200" class="h-44 w-44 text-white/20" aria-hidden="true">
                <circle cx="100" cy="100" r="78" fill="none" stroke="currentColor" stroke-width="2"
                ></circle>
                <circle cx="100" cy="100" r="52" fill="none" stroke="currentColor" stroke-width="2"
                ></circle>
                <!-- O ponto gira preso ao anel externo (r=78): o <g> roda em
                     torno do centro e o círculo mantém sua posição relativa
                     a ele, como uma órbita de verdade. -->
                <g class="orbita-ponto">
                  <circle cx="168" cy="62" r="11" fill="currentColor" class="text-butter-200"></circle>
                </g>
              </svg>
            </div>
          </div>

          <div
            class="border-ink-900/15 absolute -bottom-4 -left-4 flex items-center gap-3 rounded-2xl border bg-white px-4 py-3 shadow-lg"
          >
            <span class="bg-peri-500 grid size-9 shrink-0 place-items-center rounded-full text-white">
              <Icon name="bolt" class="size-4" />
            </span>
            <div>
              <p class="text-sm leading-none font-semibold">LCP médio &lt; 1,5s</p>
              <p class="text-ink-500 mt-1 text-xs">medido nas entregas</p>
            </div>
          </div>
        </div>
      </div>

      <dl class="border-ink-900/15 mt-16 grid grid-cols-2 gap-8 border-t pt-8 sm:grid-cols-4">
        {
          NUMEROS.map((n) => (
            <div>
              <dt class="sr-only">{n.label}</dt>
              <dd>
                <span class="display text-peri-600 block text-4xl sm:text-5xl">{n.valor}</span>
                <span class="text-ink-700 mt-1.5 block text-xs font-medium tracking-wide uppercase">
                  {n.label}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- SERVIÇOS -->
    <section
      class="bg-peri-500 overflow-hidden rounded-3xl px-6 py-14 text-white sm:px-12 sm:py-20"
    >
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <div>
          <p class="text-butter-200 text-xs font-semibold tracking-widest uppercase">
            No que trabalhamos
          </p>
          <h2 class="display text-butter-100 mt-4 text-5xl text-balance sm:text-6xl">
            Frentes que destravam um e-commerce
          </h2>
          <p class="mt-5 max-w-sm leading-relaxed text-white/85">
            Cada projeto entra com um time pequeno e dedicado. Sem repasse para terceiros, sem
            código que você não pode ler depois.
          </p>
        </div>

        <ul class="space-y-3">
          {
            SERVICOS.map((servico) => (
              <li class="flex items-start gap-4 rounded-2xl bg-white/10 px-5 py-4 transition-colors hover:bg-white/15">
                <span class="bg-butter-200 text-peri-700 mt-0.5 grid size-10 shrink-0 place-items-center rounded-xl">
                  <Icon name={servico.icone} class="size-5" />
                </span>
                <div>
                  <h3 class="font-semibold">{servico.titulo}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-white/80">{servico.texto}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- PROCESSO -->
    <section class="bg-butter-200 rounded-3xl px-6 py-14 sm:px-12 sm:py-20">
      <p class="text-ink-500 text-xs font-semibold tracking-widest uppercase">Como trabalhamos</p>
      <h2 class="display mt-4 max-w-2xl text-5xl sm:text-6xl">Nosso processo</h2>

      <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          PROCESSO.map((etapa, i) => (
            <li class="border-ink-900/10 flex flex-col rounded-2xl border bg-white px-6 py-7">
              <span class="bg-peri-500 display grid size-11 place-items-center rounded-full text-lg text-white">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 text-lg font-semibold">{etapa.titulo}</h3>
              <p class="text-ink-700 mt-2 text-sm leading-relaxed">{etapa.texto}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- PROJETOS -->
    <section id="projetos" class="scroll-mt-24 rounded-3xl bg-white px-6 py-14 sm:px-12 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="text-ink-500 text-xs font-semibold tracking-widest uppercase">
            Projetos em destaque
          </p>
          <h2 class="display mt-4 text-5xl sm:text-6xl">Resultados reais</h2>
        </div>
        <a
          href="/projetos"
          class="border-ink-900/25 hover:bg-ink-900/5 inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-semibold transition-colors"
        >
          Ver todos
          <Icon name="arrow" class="size-4" />
        </a>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          destaques.map((projeto, i) => (
            <ProjectCard projeto={projeto} tom={i % 2 === 0 ? 'creme' : 'branco'} />
          ))
        }
      </div>

      {
        destaques.length === 0 && (
          <p class="text-ink-500 mt-10">
            Nenhum projeto publicado. Adicione um arquivo em <code>src/content/projetos/</code>.
          </p>
        )
      }
    </section>

    <!-- DEPOIMENTOS -->
    <section class="bg-butter-200 rounded-3xl px-6 py-14 sm:px-12 sm:py-20">
      <p class="text-ink-500 text-xs font-semibold tracking-widest uppercase">Depoimentos</p>
      <h2 class="display mt-4 max-w-2xl text-5xl sm:text-6xl">O que dizem sobre nós</h2>

      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {
          DEPOIMENTOS.map((d) => (
            <figure class="border-ink-900/10 flex flex-col rounded-2xl border bg-white px-7 py-8">
              <span class="display text-peri-400 text-5xl leading-none" aria-hidden="true">
                &ldquo;
              </span>
              <blockquote class="text-ink-900 mt-2 leading-relaxed">{d.texto}</blockquote>
              <figcaption class="text-ink-500 mt-6 text-sm">
                <span class="text-ink-900 block font-semibold">{d.autor}</span>
                {d.cargo}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- STACK -->
    <section class="rounded-3xl bg-white px-6 py-14 sm:px-12 sm:py-16">
      <p class="text-ink-500 text-xs font-semibold tracking-widest uppercase">Stack</p>
      <ul class="mt-6 flex flex-wrap gap-2.5">
        {
          STACK.map((tec) => (
            <li class="border-ink-900/15 bg-butter-50 rounded-full border px-4 py-2 text-sm font-medium">
              {tec}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- CTA -->
    <section class="bg-peri-900 rounded-3xl px-6 py-16 text-center sm:px-12 sm:py-24">
      <h2 class="display text-butter-200 mx-auto max-w-3xl text-5xl sm:text-7xl">
        Tem um projeto em mente?
      </h2>
      <p class="text-peri-300 mx-auto mt-5 max-w-xl leading-relaxed">
        Conte pra gente o que você precisa construir. Respondemos com um diagnóstico honesto do
        escopo — inclusive se não formos o time certo para o trabalho.
      </p>
      <a
        href={`mailto:${SITE.email}`}
        class="bg-butter-200 text-ink-900 hover:bg-butter-100 mt-9 inline-flex items-center gap-2 rounded-full px-8 py-4 font-semibold transition-colors"
      >
        <Icon name="mail" class="size-5" />
        {SITE.email}
      </a>
    </section>
  </div>
</Layout>

<style>
  /* Roda em torno do centro do viewBox (200x200 → 100,100). transform-box:
     view-box ancora a origem no sistema de coordenadas do SVG, não na
     bounding box do próprio <g> — sem isso a órbita fica descentralizada. */
  .orbita-ponto {
    transform-box: view-box;
    transform-origin: 100px 100px;
    animation: orbitar 10s linear infinite;
  }

  @keyframes orbitar {
    to {
      transform: rotate(360deg);
    }
  }
</style>
