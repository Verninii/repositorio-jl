---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import placeholder from '../../assets/placeholder-projeto.webp';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../consts';

export const getStaticPaths = (async () => {
  const projetos = await getCollection('projetos', ({ data }) => !data.draft);
  return projetos.map((projeto) => ({
    params: { slug: projeto.id },
    props: { projeto },
  }));
}) satisfies GetStaticPaths;

const { projeto } = Astro.props;
const { Content } = await render(projeto);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: projeto.data.title,
  description: projeto.data.description,
  url: new URL(`/projetos/${projeto.id}`, SITE.url).href,
  dateCreated: String(projeto.data.ano),
  creator: { '@type': 'Organization', name: SITE.company, url: SITE.url },
  keywords: projeto.data.stack.join(', '),
};
---

<Layout
  title={projeto.data.title}
  description={projeto.data.description}
  type="article"
  schema={schema}
>
  <article>
    <section
      class="bg-noite-950 relative isolate w-full overflow-hidden pt-8 pb-[calc(4rem+var(--folha))] sm:pt-12 sm:pb-[calc(6rem+var(--folha))]"
    >
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <div class="grade absolute inset-0 opacity-60"></div>
        <div
          class="absolute -top-40 -right-24 size-[34rem] bg-[radial-gradient(closest-side,rgb(59_123_224/0.4),transparent)]"
        >
        </div>
      </div>
      <div class="mx-auto max-w-7xl px-6 sm:px-10">
        <a
          href="/projetos"
          class="text-noite-300 hover:text-white inline-flex items-center gap-2 text-sm font-medium transition-colors"
        >
          <Icon name="arrow" class="size-4 rotate-180" />
          Todos os projetos
        </a>

        <p class="rotulo text-noite-300 mt-8 flex items-center gap-2">
          <span
            class="size-2 rounded-full"
            style={`background:${projeto.data.accent}`}
            aria-hidden="true"></span>
          {projeto.data.tipo}
        </p>

        <h1 class="display mt-4 max-w-4xl text-5xl text-white sm:text-7xl">{projeto.data.title}</h1>
        <p class="text-noite-200/85 mt-5 max-w-2xl text-lg leading-relaxed">
          {projeto.data.description}
        </p>

        <dl class="mt-10 grid border-white/15 grid-cols-2 gap-6 border-t pt-8 text-sm sm:grid-cols-3">
          {
            projeto.data.cliente && (
              <div>
                <dt class="text-noite-300 text-xs font-semibold tracking-widest uppercase">
                  Cliente
                </dt>
                <dd class="mt-1.5 font-medium">{projeto.data.cliente}</dd>
              </div>
            )
          }
          <div>
            <dt class="text-noite-300 text-xs font-semibold tracking-widest uppercase">Ano</dt>
            <dd class="mt-1.5 font-medium">{projeto.data.ano}</dd>
          </div>
          {
            projeto.data.stack.length > 0 && (
              <div>
                <dt class="text-noite-300 text-xs font-semibold tracking-widest uppercase">
                  Stack
                </dt>
                <dd class="mt-1.5 font-medium">{projeto.data.stack.join(', ')}</dd>
              </div>
            )
          }
        </dl>

        {
          (projeto.data.url || projeto.data.repo) && (
            <p class="mt-8 flex flex-wrap gap-3 text-sm">
              {projeto.data.url && (
                <a
                  href={projeto.data.url}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="text-noite-900 hover:bg-noite-100 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 font-semibold transition-colors"
                >
                  Ver no ar
                  <Icon name="arrow" class="size-4" />
                </a>
              )}
              {projeto.data.repo && (
                <a
                  href={projeto.data.repo}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="inline-flex border-white/30 hover:border-white/60 hover:bg-white/10 items-center gap-2 rounded-full border px-6 py-3 font-semibold transition-colors"
                >
                  Repositório
                </a>
              )}
            </p>
          )
        }
      </div>
    </section>

    {
      projeto.data.metricas.length > 0 && (
        <section
          class="folha bg-noite-700 w-full pt-14 pb-[calc(3.5rem+var(--folha))] text-white sm:pt-16 sm:pb-[calc(4rem+var(--folha))]"
        >
          <div class="mx-auto max-w-7xl px-6 sm:px-10">
            <p class="rotulo text-noite-300">Os resultados</p>
            <dl class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-3">
              {projeto.data.metricas.map((m) => (
                <div>
                  <dt class="sr-only">{m.label}</dt>
                  <dd>
                    <span class="display block text-5xl text-white">{m.valor}</span>
                    <span class="text-noite-200 mt-2 block text-sm">{m.label}</span>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )
    }

    <section
      class="folha bg-noite-100 text-noite-900 w-full pt-16 pb-[calc(4rem+var(--folha))] sm:pt-24 sm:pb-[calc(6rem+var(--folha))]"
    >
      <div class="mx-auto max-w-7xl px-6 sm:px-10">
        <Image
          src={projeto.data.capa ?? placeholder}
          alt={projeto.data.capa ? (projeto.data.capaAlt ?? projeto.data.title) : ''}
          class="border-noite-200 mb-12 w-full rounded-2xl border"
          widths={[640, 1024, 1536]}
          sizes="(min-width: 1024px) 1024px, 100vw"
          loading="eager"
          aria-hidden={projeto.data.capa ? undefined : 'true'}
        />

        <div
          class="prose prose-lg prose-headings:text-noite-900 prose-headings:font-bold prose-headings:tracking-tight prose-h2:text-3xl prose-p:text-noite-900/80 prose-li:text-noite-900/80 prose-strong:text-noite-900 prose-a:text-noite-700 mx-auto max-w-2xl"
        >
          <Content />
        </div>
      </div>
    </section>

    <section
      class="folha bg-noite-900 w-full pt-16 pb-[calc(4rem+var(--folha))] text-center text-white sm:pt-20 sm:pb-[calc(5rem+var(--folha))]"
    >
      <div class="mx-auto max-w-7xl px-6 sm:px-10">
        <h2 class="display mx-auto max-w-2xl text-4xl text-white sm:text-5xl">
          Quer um resultado parecido?
        </h2>
        <a
          href={`mailto:${SITE.email}`}
          class="text-noite-900 hover:bg-noite-100 mt-8 inline-flex items-center gap-2 rounded-full bg-white px-7 py-3.5 font-semibold transition-colors"
        >
          <Icon name="mail" class="size-5" />
          {SITE.email}
        </a>
      </div>
    </section>
  </article>
</Layout>
