---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import placeholder from '../../assets/placeholder-projeto.webp';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../consts';

export const getStaticPaths = (async () => {
  const projetos = await getCollection('projetos', ({ data }) => !data.draft);
  return projetos.map((projeto) => ({
    params: { slug: projeto.id },
    props: { projeto },
  }));
}) satisfies GetStaticPaths;

const { projeto } = Astro.props;
const { Content } = await render(projeto);

// JSON-LD de portfólio: ajuda o Google a entender que a página descreve um trabalho.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: projeto.data.title,
  description: projeto.data.description,
  url: new URL(`/projetos/${projeto.id}`, SITE.url).href,
  dateCreated: String(projeto.data.ano),
  creator: { '@type': 'Organization', name: SITE.company, url: SITE.url },
  keywords: projeto.data.stack.join(', '),
};
---

<Layout
  title={projeto.data.title}
  description={projeto.data.description}
  type="article"
  schema={schema}
>
  <article>
    <!-- Cabeçalho -->
    <section class="bg-butter-200 w-full py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 sm:px-10">
        <a
          href="/projetos"
          class="text-ink-500 hover:text-ink-900 inline-flex items-center gap-2 text-sm font-medium transition-colors"
        >
          <Icon name="arrow" class="size-4 rotate-180" />
          Todos os projetos
        </a>

        <p class="text-ink-500 mt-8 flex items-center gap-2 text-xs font-semibold tracking-widest uppercase">
          <span
            class="size-2 rounded-full"
            style={`background:${projeto.data.accent}`}
            aria-hidden="true"></span>
          {projeto.data.tipo}
        </p>

        <h1 class="display text-peri-500 mt-4 max-w-4xl text-5xl sm:text-7xl">{projeto.data.title}</h1>
        <p class="text-ink-700 mt-5 max-w-2xl text-lg leading-relaxed">
          {projeto.data.description}
        </p>

        <dl class="border-ink-900/15 mt-10 grid grid-cols-2 gap-6 border-t pt-8 text-sm sm:grid-cols-3">
          {
            projeto.data.cliente && (
              <div>
                <dt class="text-ink-500 text-xs font-semibold tracking-widest uppercase">
                  Cliente
                </dt>
                <dd class="mt-1.5 font-medium">{projeto.data.cliente}</dd>
              </div>
            )
          }
          <div>
            <dt class="text-ink-500 text-xs font-semibold tracking-widest uppercase">Ano</dt>
            <dd class="mt-1.5 font-medium">{projeto.data.ano}</dd>
          </div>
          {
            projeto.data.stack.length > 0 && (
              <div>
                <dt class="text-ink-500 text-xs font-semibold tracking-widest uppercase">
                  Stack
                </dt>
                <dd class="mt-1.5 font-medium">{projeto.data.stack.join(', ')}</dd>
              </div>
            )
          }
        </dl>

        {
          (projeto.data.url || projeto.data.repo) && (
            <p class="mt-8 flex flex-wrap gap-3 text-sm">
              {projeto.data.url && (
                <a
                  href={projeto.data.url}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="bg-ink-900 hover:bg-peri-600 inline-flex items-center gap-2 rounded-full px-6 py-3 font-semibold text-white transition-colors"
                >
                  Ver no ar
                  <Icon name="arrow" class="size-4" />
                </a>
              )}
              {projeto.data.repo && (
                <a
                  href={projeto.data.repo}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="border-ink-900/25 hover:bg-ink-900/5 inline-flex items-center gap-2 rounded-full border px-6 py-3 font-semibold transition-colors"
                >
                  Repositório
                </a>
              )}
            </p>
          )
        }
      </div>
    </section>

    <!-- Métricas -->
    {
      projeto.data.metricas.length > 0 && (
        <section class="bg-peri-500 w-full py-14 text-white sm:py-16">
          <div class="mx-auto max-w-7xl px-6 sm:px-10">
            <p class="text-butter-200 text-xs font-semibold tracking-widest uppercase">
              Os resultados
            </p>
            <dl class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-3">
              {projeto.data.metricas.map((m) => (
                <div>
                  <dt class="sr-only">{m.label}</dt>
                  <dd>
                    <span class="display text-butter-200 block text-5xl">{m.valor}</span>
                    <span class="text-peri-300 mt-2 block text-sm">{m.label}</span>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )
    }

    <!-- Conteúdo -->
    <section class="bg-butter-50 w-full py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 sm:px-10">
        <!-- Sem screenshot do projeto ainda: cai no placeholder. -->
        <Image
          src={projeto.data.capa ?? placeholder}
          alt={projeto.data.capa ? (projeto.data.capaAlt ?? projeto.data.title) : ''}
          class="border-ink-900/10 mb-12 w-full rounded-2xl border"
          widths={[640, 1024, 1536]}
          sizes="(min-width: 1024px) 1024px, 100vw"
          loading="eager"
          aria-hidden={projeto.data.capa ? undefined : 'true'}
        />

        <div
          class="prose prose-lg prose-headings:text-ink-900 prose-h2:font-display prose-h2:font-normal prose-h2:uppercase prose-h2:tracking-tight prose-h2:text-3xl prose-p:text-ink-700 prose-li:text-ink-700 prose-a:text-peri-600 mx-auto max-w-2xl"
        >
          <Content />
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-peri-900 w-full py-16 text-center sm:py-20">
      <div class="mx-auto max-w-7xl px-6 sm:px-10">
        <h2 class="display text-butter-200 mx-auto max-w-2xl text-4xl sm:text-5xl">
          Quer um resultado parecido?
        </h2>
        <a
          href={`mailto:${SITE.email}`}
          class="bg-butter-200 text-ink-900 hover:bg-butter-100 mt-8 inline-flex items-center gap-2 rounded-full px-7 py-3.5 font-semibold transition-colors"
        >
          <Icon name="mail" class="size-5" />
          {SITE.email}
        </a>
      </div>
    </section>
  </article>
</Layout>
