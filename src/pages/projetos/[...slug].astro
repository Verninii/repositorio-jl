---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../consts';

export const getStaticPaths = (async () => {
  const projetos = await getCollection('projetos', ({ data }) => !data.draft);
  return projetos.map((projeto) => ({
    params: { slug: projeto.id },
    props: { projeto },
  }));
}) satisfies GetStaticPaths;

const { projeto } = Astro.props;
const { Content } = await render(projeto);

// JSON-LD de portfólio: ajuda o Google a entender que a página descreve um trabalho.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: projeto.data.title,
  description: projeto.data.description,
  url: new URL(`/projetos/${projeto.id}`, SITE.url).href,
  dateCreated: String(projeto.data.ano),
  creator: { '@type': 'Person', name: SITE.author, url: SITE.url },
  keywords: projeto.data.stack.join(', '),
};
---

<Layout
  title={projeto.data.title}
  description={projeto.data.description}
  type="article"
  schema={schema}
>
  <article class="py-12">
    <header class="border-b border-neutral-800 pb-8">
      <h1 class="text-3xl font-semibold tracking-tight text-balance">{projeto.data.title}</h1>
      <p class="mt-3 text-lg text-neutral-400">{projeto.data.description}</p>

      <dl class="mt-6 grid grid-cols-2 gap-4 text-sm sm:grid-cols-3">
        {projeto.data.cliente && (
          <div>
            <dt class="text-neutral-500">Cliente</dt>
            <dd>{projeto.data.cliente}</dd>
          </div>
        )}
        <div>
          <dt class="text-neutral-500">Ano</dt>
          <dd>{projeto.data.ano}</dd>
        </div>
        {projeto.data.stack.length > 0 && (
          <div>
            <dt class="text-neutral-500">Stack</dt>
            <dd>{projeto.data.stack.join(', ')}</dd>
          </div>
        )}
      </dl>

      {(projeto.data.url || projeto.data.repo) && (
        <p class="mt-6 flex gap-4 text-sm">
          {projeto.data.url && (
            <a href={projeto.data.url} rel="noopener noreferrer" target="_blank" class="underline">
              Ver no ar
            </a>
          )}
          {projeto.data.repo && (
            <a href={projeto.data.repo} rel="noopener noreferrer" target="_blank" class="underline">
              Repositório
            </a>
          )}
        </p>
      )}
    </header>

    {projeto.data.capa && (
      <Image
        src={projeto.data.capa}
        alt={projeto.data.capaAlt ?? projeto.data.title}
        class="mt-8 rounded-lg border border-neutral-800"
        loading="eager"
      />
    )}

    <div class="prose-invert mt-8 max-w-prose space-y-4 leading-relaxed text-neutral-300">
      <Content />
    </div>
  </article>
</Layout>
