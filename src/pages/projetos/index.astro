---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projetos = (await getCollection('projetos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.ano - a.data.ano,
);
---

<Layout
  title="Projetos"
  description="Projetos freelance de desenvolvimento web entregues: escopo, stack e resultado de cada um."
>
  <h1 class="py-12 text-3xl font-semibold tracking-tight">Projetos</h1>

  <ul class="space-y-8 border-t border-neutral-800 pt-8">
    {
      projetos.map((projeto) => (
        <li>
          <article>
            <h2 class="text-xl font-medium">
              <a href={`/projetos/${projeto.id}`} class="hover:underline">
                {projeto.data.title}
              </a>
            </h2>
            <p class="mt-2 text-neutral-400">{projeto.data.description}</p>
            <p class="mt-3 text-xs text-neutral-500">
              {projeto.data.cliente && <span>{projeto.data.cliente} · </span>}
              <span>{projeto.data.ano}</span>
            </p>
          </article>
        </li>
      ))
    }
  </ul>
</Layout>
