---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projetos = (await getCollection('projetos', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.ordem - b.data.ordem || b.data.ano - a.data.ano,
);
---

<Layout
  title="Projetos"
  description="Projetos de e-commerce e desenvolvimento web entregues pelo nosso time: escopo, stack e resultado de cada um."
>
  <section
    class="relative isolate w-full overflow-hidden bg-noite-950 pt-8 pb-[calc(5rem+var(--folha))] sm:pt-12 sm:pb-[calc(6rem+var(--folha))]"
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="grade absolute inset-0 opacity-60"></div>
      <div
        class="absolute -top-40 -right-24 size-[34rem] bg-[radial-gradient(closest-side,rgb(59_123_224/0.4),transparent)]"
      >
      </div>
    </div>
    <div class="mx-auto max-w-7xl px-6 sm:px-10">
      <p class="rotulo text-noite-300">Portfólio</p>
      <h1 class="display mt-4 text-6xl text-white sm:text-8xl">Projetos</h1>
      <p class="text-noite-200/85 mt-6 max-w-xl text-lg leading-relaxed">
        Cada card abre um estudo de caso com o contexto do cliente, as decisões técnicas e o que
        foi medido depois da entrega.
      </p>
    </div>
  </section>

  <section
    class="folha bg-noite-100 text-noite-900 w-full pt-16 pb-[calc(4rem+var(--folha))] sm:pt-20 sm:pb-[calc(5rem+var(--folha))]"
  >
    <div class="mx-auto max-w-7xl px-6 sm:px-10">
      <div class="grid gap-6 sm:grid-cols-2">
        {projetos.map((projeto) => <ProjectCard projeto={projeto} />)}
      </div>

      {
        projetos.length === 0 && (
          <p class="text-noite-900/70">
            Nenhum projeto publicado. Adicione um arquivo em <code>src/content/projetos/</code>.
          </p>
        )
      }
    </div>
  </section>
</Layout>
